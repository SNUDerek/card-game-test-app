# Copy to .env and edit. Docker Compose reads .env automatically.

# Port the tabletop UI is served on.
CLIENT_PORT=9000

# Port the Colyseus/Express server listens on, inside and outside the container.
SERVER_PORT=9001

# Where browsers should reach the tabletop server.
#
# Leave empty for the usual case: the client reaches the server through its own
# origin, proxied by nginx. Only CLIENT_PORT then has to be open, and the same
# image works on any hostname -- localhost, a LAN address, or a remote host --
# with no rebuild.
#
# Set it only when the server is exposed separately and the browser must talk to
# it directly, in which case SERVER_PORT has to be reachable too:
#
#   PUBLIC_SERVER_URL=http://my.publicserver.com:9001
#
# Use https:// when serving over TLS; the client upgrades the socket to wss.
PUBLIC_SERVER_URL=

# Address the "Copy link" button should build room links from, port included.
#
# Leave empty to use whatever address the browser loaded the page from, which is
# right whenever everyone reaches the table the same way. Set it when they do
# not -- a session opened on the host itself would otherwise share a localhost
# link, which is useless to anyone else:
#
#   PUBLIC_CLIENT_URL=http://my.publicserver.com:9000
PUBLIC_CLIENT_URL=
