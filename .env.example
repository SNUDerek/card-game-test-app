# Copy to .env and edit. Docker Compose reads .env automatically.

# Port the tabletop UI is served on. This is the only port browsers need.
CLIENT_PORT=8080

# Internal port the server listens on. Only nginx in the client container reaches
# it, so it does not need to be published or opened in a firewall.
SERVER_PORT=2567

# Required server-side secret mixed into every password hash. Generate a long,
# random value, for example with: openssl rand -base64 48
AUTH_PEPPER=

# Required to self-register. Leave empty to disable browser registration and
# bootstrap accounts with `npm run user:create -w server -- username "Name"`.
SIGNUP_PASSCODE=

# Use true whenever the public site is HTTPS.
COOKIE_SECURE=false

# Number of trusted reverse-proxy hops (nginx is one hop locally). Behind a
# Cloudflare Tunnel, see docs/hosting.md.
TRUST_PROXY=1

# Rate-limit by Cloudflare's CF-Connecting-IP header. Enable only when every
# request reaches the site through Cloudflare; otherwise clients can spoof it.
TRUST_CLOUDFLARE_IP=false

# Address the "Copy link" button should build room links from, port included.
#
# Leave empty to use whatever address the browser loaded the page from, which is
# right whenever everyone reaches the table the same way. Set it when they do
# not -- a session opened on the host itself would otherwise share a localhost
# link, which is useless to anyone else:
#
#   PUBLIC_CLIENT_URL=http://my.publicserver.com:9000
PUBLIC_CLIENT_URL=

# Accounts, sets, cards, decks, and uploaded images are stored in the
# `workspace-data` Docker volume, mounted at DATA_DIR=/app/data inside the server
# container. Compose sets DATA_DIR itself; outside Docker it defaults to ./data.
