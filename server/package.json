{
  "name": "@card-table/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env.development src/index.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "user:create": "tsx src/auth/create-user.ts",
    "cards:import": "tsx src/library/import-cards-cli.ts"
  },
  "dependencies": {
    "@card-table/shared": "*",
    "@colyseus/ws-transport": "^0.18.3",
    "better-sqlite3": "^13.0.3",
    "colyseus": "^0.18.8",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "image-size": "^2.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@colyseus/testing": "^0.18.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
